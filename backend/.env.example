# Backend configuration for the ATLAS portfolio analytics service.
#
# Copy to `.env` (or export these in your shell) and adjust. Every value has
# a working default, so the service runs with no configuration at all.
#
# The backend reads the environment directly; the variables below are the
# complete list. In Docker they are set in docker-compose.yml instead.

# --- Reporting -------------------------------------------------------------

# Fallback reporting currency when the store has no explicit setting.
PORTFOLIO_BASE_CURRENCY=EUR

# Benchmark symbol, its display name, and whether it is a total-return
# series. The default is the S&P 500 total-return index, because holdings'
# prices are dividend-adjusted; a price-only index such as ^GSPC still works,
# but set this flag to false so the UI can say so.
PORTFOLIO_BENCHMARK=^SP500TR
PORTFOLIO_BENCHMARK_NAME=S&P 500 (total return)
PORTFOLIO_BENCHMARK_INCLUDES_DIVIDENDS=true

# --- Methodology -----------------------------------------------------------

# Annual risk-free rate as a decimal (0.02 = 2%). Used by Sharpe, Sortino
# and the de-annualised daily rate.
PORTFOLIO_RISK_FREE_RATE=0.02

# Years of daily history to fetch (1-15).
PORTFOLIO_HISTORY_YEARS=2

# Monte Carlo: number of paths (100-200000) and horizon in trading days.
PORTFOLIO_MC_PATHS=10000
PORTFOLIO_MC_HORIZON_DAYS=252

# --- Data ------------------------------------------------------------------

# Age, in hours, at which the on-disk price cache is refetched.
PORTFOLIO_CACHE_TTL_HOURS=12

# SQLite database holding the stored positions.
PORTFOLIO_DB_PATH=backend/data/portfolio.db

# Legacy JSON position file, read by setup_holdings.py and the snapshot
# generator.
PORTFOLIO_HOLDINGS_PATH=backend/holdings.json

# Where prices are cached and where snapshot.json is written.
PORTFOLIO_CACHE_DIR=backend/.cache
PORTFOLIO_SNAPSHOT_PATH=snapshot.json

# The built single-page application, served by the API in production.
PORTFOLIO_FRONTEND_DIST=frontend/dist

# --- Behaviour -------------------------------------------------------------

# Seed the bundled example portfolio on first boot. Set to false for an
# empty portfolio that only ever contains the positions you add.
PORTFOLIO_SEED_DEMO=true

# Comma-separated browser origins allowed to call the API.
PORTFOLIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When set, every data route requires a matching X-API-Key header. Leave
# empty for a local, single-user deployment.
# PORTFOLIO_API_KEY=
