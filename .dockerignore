# Build context exclusions. The image is built from the Dockerfile; anything
# that is not needed at runtime is left out.

.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
node_modules
frontend/node_modules
frontend/dist
backend/.cache
# The portfolio database is runtime state; the bundled market datasets the
# bonds and macro views read are part of the application and must ship.
backend/data/*
!backend/data/fixed_income
!backend/data/macro
*.md
!README.md
docs
.DS_Store
*.log
.env
.env.*
