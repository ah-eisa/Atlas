# Build context exclusions. The image is built from the Dockerfile; anything
# that is not needed at runtime is left out.

.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
node_modules
frontend/node_modules
frontend/dist
backend/.cache
backend/data
*.md
!README.md
docs
.DS_Store
*.log
.env
.env.*
