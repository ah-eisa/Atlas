# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Price cache (regenerated from yfinance on demand)
backend/.cache/

# SQLite database of stored positions (created on first boot)
backend/data/
*.db
*.db-wal
*.db-shm

# Node / Vite
node_modules/
frontend/dist/
frontend/.vite/

# Environment
.env
.env.*
!.env.example

# Your own portfolio.
#
# These are tracked by default so a fresh clone renders the example dashboard
# immediately. If you fork this repo and put real positions in, uncomment the
# two lines below and run:
#
#   git rm --cached backend/holdings.json snapshot.json
#
# otherwise your holdings would be published with your fork.
# backend/holdings.json
# snapshot.json

# Backups written by setup_holdings.py
backend/holdings.backup-*.json

# OS
.DS_Store
